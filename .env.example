# TMDB API key used by `scripts/fetch-movie.mjs` to fetch the "now watching"
# poster at build time. The key is only ever read by the build script - it is
# never committed and never shipped to the browser.
#
# Get a free key: https://www.themoviedb.org/settings/api
# Works with either credential type:
#   - a v3 API key            (a 32-character hex string)
#   - a v4 read access token  (a long "eyJ..." JWT)
#
# Copy this file to `.env` and fill it in for local builds:
#   cp .env.example .env
TMDB_API_KEY=your_key_here